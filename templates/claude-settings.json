{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${REPO}/sources/hooks/claude/paper-format-validator.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${REPO}/sources/hooks/claude/paper-driller-subagent-log.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [],
    "deny": []
  },
  "enabledPlugins": {
    "superpowers@ssot-pinned": true
  },
  "extraKnownMarketplaces": {}
}
