      ],
      "claude_hooks": {
        "PostToolUse": [
          {
            "matcher": "Write|Edit|MultiEdit",
            "hooks": [
              {
                "type": "command",
                "command": "bash \"${CLAUDE_HOME}/hooks/ssot/paper-format-validator.sh\"",
                "timeout": 20
              }
            ]
          }
        ],
        "SubagentStop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "bash \"${CLAUDE_HOME}/hooks/ssot/paper-driller-subagent-log.sh\"",
                "timeout": 5
              }
            ]
          }
        ]
      }
    },
