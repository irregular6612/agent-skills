# PaperBanana Environment Variables
# Copy this file to .env and fill in your keys.

# OpenAI (alternative): https://platform.openai.com/api-keys
# To use OpenAI instead of Gemini, uncomment these:
# VLM_PROVIDER=openai
# IMAGE_PROVIDER=openai_imagen
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VLM_MODEL=gpt-5.2
OPENAI_IMAGE_MODEL=gpt-image-1.5
# For Azure OpenAI / Foundry, point to your endpoint:
#   OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1

# Google Gemini (free, no credit card): https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_BASE_URL=
GOOGLE_VLM_MODEL=gemini-2.5-flash-lite
GOOGLE_IMAGE_MODEL=gemini-3-pro-image

# ── Per-agent VLM model map (optional) ─────────────────────────────
# Resolution: VLM_MODEL_<SLOT> > VLM_MODEL. Unset slots fall back to VLM_MODEL.
# Note: GOOGLE_VLM_MODEL does NOT feed these slots — it only applies to the
# legacy single-VLM path. Use VLM_MODEL / VLM_MODEL_<SLOT> here.
# VLM_MODEL=gemini-2.5-flash-lite            # retriever + optimizer baseline
# VLM_MODEL_PLANNER=gemini-3.6-flash         # long multimodal reasoning
# VLM_MODEL_CRITIC=gemini-3.6-flash          # image judgement, runs N× per figure
# VLM_MODEL_VISUALIZER=gemini-3.6-flash      # plot path only (matplotlib codegen)
# VLM_MODEL_STYLIST=gemini-3.5-flash-lite    # aesthetic rewrite
# IMAGE_MODEL=gemini-3-pro-image             # or gemini-3.1-flash-image (cheaper drafts)

# ── SSL ────────────────────────────────────────────────────────────
# Set to true to skip SSL certificate verification (corporate proxies)
SKIP_SSL_VERIFICATION=false
