# latexmkrc — Force XeLaTeX for Korean rendering
#
# Generated by latex-korean-setup skill.
#
# This file is respected by BOTH:
#   - Local latexmk (called by Cursor/VSCode LaTeX Workshop)
#   - Overleaf cloud build
#
# Effect: Even without the % !TEX program magic comment, latexmk uses xelatex.
# Safe to commit to git — Overleaf will honor it.
#
# Why $pdf_mode = 5? It tells latexmk to use xelatex as the PDF generator.
#   1 = pdflatex (default, no Korean)
#   3 = lualatex
#   5 = xelatex  ← we want this

$pdf_mode = 5;
$pdflatex = 'xelatex %O -synctex=1 -interaction=nonstopmode -file-line-error %S';

# Run bibtex automatically when .bib files are referenced
$bibtex_use = 2;

# If you have .bib with Korean entries, switch to biber:
# $bibtex = 'biber';
# $biber = 'biber --validate-datamodel';
