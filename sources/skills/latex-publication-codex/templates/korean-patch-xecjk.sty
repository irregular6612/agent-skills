%% korean-patch.sty (xeCJK variant)
%% Korean rendering patch using xeCJK + Noto Sans CJK KR
%%
%% Generated by latex-korean-setup skill.
%%
%% When to use this variant instead of kotex default:
%%   - You need precise visual control over Korean fonts
%%   - You want Noto Sans CJK KR specifically (better Hangul shapes than Nanum)
%%   - The project also contains Chinese/Japanese mixed with Korean
%%
%% Trade-offs vs kotex:
%%   - Requires Noto Sans CJK KR font installed locally:
%%       brew install --cask font-noto-sans-cjk-kr
%%   - Overleaf has Noto fonts available, but verify before push
%%
%% Engine requirement: XeLaTeX only (lualatex needs different setup).
%% Ensure main.tex starts with: % !TEX program = xelatex
%%
%% Usage:
%%   1. Rename this file to korean-patch.sty when copying to project
%%   2. In main.tex: \usepackage{korean-patch}
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{korean-patch}[2026/04/17 v1.0 Korean rendering patch (xeCJK)]

\RequirePackage{fontspec}
\RequirePackage{xeCJK}

% Korean font setup — Noto Sans CJK KR is available on both macOS (after brew install)
% and Overleaf (server-side). Avoid system-only fonts like "Apple SD Gothic Neo".
\setCJKmainfont{Noto Sans CJK KR}
\setCJKsansfont{Noto Sans CJK KR}
\setCJKmonofont{Noto Sans Mono CJK KR}

% Disable auto-space between CJK and Latin (typically desired in academic writing)
\xeCJKsetup{CJKecglue={}}

\endinput
