{
  "//": "Generated by latex-korean-setup skill. LOCAL-ONLY: do NOT commit to Overleaf.",
  "//1": "Place at .vscode/settings.json (Cursor reads .vscode/ as well as .cursor/).",

  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.recipes": [
    {
      "name": "xelatex (latexmk)",
      "tools": ["latexmk-xe"]
    },
    {
      "name": "xelatex × 2 + bibtex (manual)",
      "tools": ["xelatex", "bibtex", "xelatex", "xelatex"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-xe",
      "command": "latexmk",
      "args": [
        "-xelatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      "name": "xelatex",
      "command": "xelatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      "name": "bibtex",
      "command": "bibtex",
      "args": ["%DOCFILE%"]
    }
  ],

  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.autoClean.run": "onFailed",
  "latex-workshop.latex.clean.subfolder.enabled": true,
  "latex-workshop.latex.outDir": "./build",

  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.synctex.afterBuild.enabled": true,

  "latex-workshop.message.badbox.show": false,
  "latex-workshop.message.warning.show": true,
  "latex-workshop.message.error.show": true,

  "//2": "If kpsewhich is not on PATH (Mac users with MacTeX), uncomment below:",
  "//3": "\"latex-workshop.latex.path\": \"/Library/TeX/texbin\""
}
