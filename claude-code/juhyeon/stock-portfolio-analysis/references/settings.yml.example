# Portfolio Analysis Settings
# Save as: ~/.config/portfolio-analysis/settings.yml

# 채널 가중치 — 합이 1.0이 아니어도 자동 정규화됨
# 프리셋: balanced | long_term_value | momentum_trader | news_driven | technical | growth_chase
preset: balanced

weights:
  news: 0.30
  fundamentals: 0.40
  chart: 0.30

# 최종 verdict 임계값 (총점 기준)
thresholds:
  strong_buy: 1.5
  buy: 0.5
  reduce: -0.5
  strong_sell: -1.5

# 포트폴리오 총평가 표시 통화
base_currency: KRW          # 'KRW' or 'USD'

# 분석 옵션
options:
  ohlcv_days: 250           # OHLCV 페치 기간 (영업일)
  news_window_days: 7       # 뉴스 검색 기간
  cache_ttl_hours: 24       # 같은 날 재실행 시 OHLCV 캐시 사용
  skip_neutral_in_summary: false  # 중립 종목 portfolio summary에서 숨길지

# API 키 (선택 — 없으면 무료 fallback 사용)
# api_keys:
#   finnhub: env:FINNHUB_API_KEY      # ~/.config/portfolio-analysis/.env에서 읽음
#   alphavantage: env:ALPHAVANTAGE_API_KEY
#   dart: env:DART_API_KEY            # 한국 펀더멘털 강화

# 차트 렌더링 옵션 (Phase 2.5)
chart:
  intraday_interval: "15m"     # 1m | 5m | 15m | 30m | 60m
  intraday_days: 30
  render_chart: true           # PNG 생성 on/off

# 펀더멘털 deterministic rubric 경로 (생략 시 스킬 default 사용)
# fundamentals_rubric: ~/.config/portfolio-analysis/fundamentals-rubric.yml
