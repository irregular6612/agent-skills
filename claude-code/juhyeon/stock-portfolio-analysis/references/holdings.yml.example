# Portfolio Holdings Configuration
# Save this file as: ~/.config/portfolio-analysis/holdings.yml
#
# Each holding requires: ticker, quantity, avg_buy_price, currency
# Optional: market (auto-detected), tags, target_weight_pct, notes
#
# KRX tickers:
#   - 6-digit code + `.KS` (KOSPI) or `.KQ` (KOSDAQ) suffix
#   - e.g., 005930.KS (삼성전자), 035720.KS (카카오), 247540.KQ (에코프로비엠)
#
# US tickers:
#   - standard symbol, no suffix
#   - e.g., NVDA, AAPL, GOOGL, SPY (ETF supported)

base_currency: KRW          # 'KRW' or 'USD' — 포트폴리오 총평가 표시 기준

holdings:
  - ticker: "005930.KS"
    quantity: 50
    avg_buy_price: 70000
    currency: KRW
    notes: "삼성전자 — 메모리 사이클 회복 베팅"
    tags: [반도체, 대형주, 배당주]

  - ticker: "035720.KS"
    quantity: 30
    avg_buy_price: 48000
    currency: KRW
    notes: "카카오 — 플랫폼 비즈니스 턴어라운드"
    tags: [인터넷, 플랫폼]

  - ticker: "NVDA"
    quantity: 10
    avg_buy_price: 450.00
    currency: USD
    notes: "엔비디아 — AI 인프라 메가트렌드"
    tags: [반도체, AI, 미국]

  - ticker: "AAPL"
    quantity: 25
    avg_buy_price: 178.50
    currency: USD
    notes: "애플 — 서비스 매출 비중 확대"
    tags: [빅테크, 배당]

  - ticker: "SPY"
    quantity: 5
    avg_buy_price: 510.00
    currency: USD
    notes: "S&P 500 ETF — 시장 노출"
    tags: [ETF, 패시브]

# Optional: alerts/triggers (v2 기능 예정)
# alerts:
#   005930.KS:
#     - condition: "verdict_changes_to: 강매도"
#       notify: email
