%% korean-patch.sty
%% Korean rendering patch for LaTeX projects (kotex variant)
%%
%% Generated by latex-korean-setup skill.
%%
%% Why kotex (default):
%%   - Bundled with TeX Live (works on Overleaf, MacTeX, TeX Live, MiKTeX)
%%   - No system font dependency (Nanum fonts auto-bundled)
%%   - Auto-selects xetexko (XeLaTeX) / luatexko (LuaLaTeX) backend
%%   - Coexists with existing inputenc/fontenc declarations
%%
%% Engine requirement: XeLaTeX or LuaLaTeX (not pdfLaTeX).
%% Ensure main.tex starts with: % !TEX program = xelatex
%%
%% Usage in main.tex:
%%   \documentclass{article}
%%   \usepackage{korean-patch}
%%
%% To rollback: just remove the \usepackage{korean-patch} line.
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{korean-patch}[2026/04/21 v1.2 Korean rendering patch (kotex, acmart-safe, emoji fallbacks)]

\RequirePackage[hangul]{kotex}

%% ── acmart compatibility (v1.1) ────────────────────────────────
%% xetexko.sty calls \linespread{1.38889} internally (for hangul mode),
%% which redefines \baselinestretch. The ACM acmart class stores the
%% original value at \documentclass-load time in \ACM@origbaselinestretch
%% and at \AtEndDocument compares \baselinestretch against it, halting
%% with "An attempt to redefine \baselinestretch detected." if changed.
%%
%% We detect acmart at \AtBeginDocument (after preamble, before body)
%% and restore \baselinestretch to its original meaning. This is a no-op
%% for non-acmart classes (\ACM@origbaselinestretch is undefined there).
%%
%% The \selectfont call refreshes the current font with the restored
%% stretch value so the body doesn't inherit xetexko's 1.38889.
\AtBeginDocument{%
  \@ifpackageloaded{xparse}{}{}%
  \ifdefined\ACM@origbaselinestretch
    \let\baselinestretch\ACM@origbaselinestretch
    \selectfont
  \fi
}

% Optional: disable auto-spacing between CJK and Latin glyphs
% (uncomment if mixed Korean-English text has unwanted gaps)
% \kscntformat{section}{}{}
% \xetexkoifdef\disablekoreanfonts\else\fi

%% ── newunicodechar fallbacks (Round 4, v1.2) ───────────────────
%% Korean Markdown documents commonly sprinkle emoji / math-symbol
%% Unicode in *prose* positions (not wrapped in $...$). XeLaTeX's
%% default LinLibertine / Inconsolata fonts have no glyph for these,
%% producing dozens of "Missing character" warnings (cosmetic but
%% noisy, and the characters literally vanish from the PDF).
%%
%% ``newunicodechar`` lets us map each codepoint to a LaTeX rendering.
%% The chosen replacements below prefer semantics over fidelity —
%% e.g. ✅ becomes ``\ding{51}`` (a heavy check mark from pifont), ✗
%% becomes ``\ding{55}``. Math-symbol Unicode (∈, ≈, ≲, ≻, ⟺) is
%% mapped to its amsmath/amssymb command wrapped in ``\ensuremath``
%% so it works in both math and text contexts.
%%
%% Packages loaded lazily: only when the patch actually needs them,
%% keeping non-Korean / emoji-free builds zero-overhead.
\RequirePackage{newunicodechar}
\RequirePackage{amssymb}           % \lesssim, \succ, \approx, ...
\IfFileExists{pifont.sty}{%
  \RequirePackage{pifont}%
  \newunicodechar{✅}{\ding{51}}%
  \newunicodechar{✗}{\ding{55}}%
  \newunicodechar{✘}{\ding{55}}%
}{%
  \newunicodechar{✅}{\checkmark}%
  \newunicodechar{✗}{\(\times\)}%
  \newunicodechar{✘}{\(\times\)}%
}
% Alert / warning / decision-point markers.
\newunicodechar{⚠}{\textbf{!}}
\newunicodechar{△}{\(\triangle\)}
\newunicodechar{◯}{\(\bigcirc\)}
% Variation Selector-16 (emoji presentation) is just noise in print —
% swallow it silently.
\newunicodechar{️}{}
% Math relations / operators frequently used in prose mid-sentence.
\newunicodechar{∈}{\ensuremath{\in}}
\newunicodechar{∉}{\ensuremath{\notin}}
\newunicodechar{≈}{\ensuremath{\approx}}
\newunicodechar{≲}{\ensuremath{\lesssim}}
\newunicodechar{≳}{\ensuremath{\gtrsim}}
\newunicodechar{≺}{\ensuremath{\prec}}
\newunicodechar{≻}{\ensuremath{\succ}}
\newunicodechar{⟺}{\ensuremath{\Longleftrightarrow}}
\newunicodechar{⟹}{\ensuremath{\Longrightarrow}}
\newunicodechar{⟸}{\ensuremath{\Longleftarrow}}
% Math italic script capitals (U+1D49C…U+1D4B5) aren't in the default
% fonts; amssymb's \mathcal or mathrsfs's \mathscr can stand in.
\newunicodechar{𝒜}{\ensuremath{\mathcal{A}}}
\newunicodechar{𝒮}{\ensuremath{\mathcal{S}}}
\newunicodechar{𝒯}{\ensuremath{\mathcal{T}}}

\endinput
