{
  "_comment": "skm sub-modes on top of day/night. Names without a prefix mean skill:<name>; use agent:<name> for subagents. Combine add-ons with + (install.py skm run paper+office). See README '세부 모드'.",
  "base": [
    "pdf",
    "handoff",
    "eli5"
  ],
  "submodes": {
    "paper": {
      "description": "논문 읽기·쓰기·인용·그림",
      "categories": [
        "research"
      ],
      "include": [
        "docx",
        "markdown-mermaid-writing"
      ],
      "exclude": [
        "research-grants",
        "korean-scholarship-search"
      ]
    },
    "autopilot-code": {
      "description": "스펙→티켓→TDD→리뷰 자동 코딩 루프",
      "categories": [
        "dev"
      ],
      "include": [
        "agent-browser",
        "agent:code-reviewer",
        "agent:debugger",
        "agent:test-writer",
        "agent:security-reviewer"
      ],
      "exclude": [
        "ask-matt",
        "setup-matt-pocock-skills"
      ]
    },
    "cloud": {
      "description": "Cloudflare 배포·운영",
      "categories": [
        "cloud"
      ]
    },
    "design": {
      "description": "프런트엔드·브랜드 디자인",
      "categories": [
        "design"
      ]
    },
    "office": {
      "description": "문서 파일(docx/pptx/xlsx/hwpx) — add-on 용",
      "categories": [
        "docs"
      ]
    }
  },
  "categories": {
