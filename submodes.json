        "citation",
        "academic",
        "literature",
        "scholar",
        "arxiv",
        "bibtex",
        "학술",
        "연구"
      ]
    },
    "dev": {
      "color": "#009E73",
      "description": "writing, testing, debugging, reviewing or designing software code and its architecture, specs and tickets",
      "keywords": [
        "codebase",
        "tdd",
        "bug",
        "debug",
        "refactor",
        "code review",
        "pull request",
        "ticket",
        "코드"
      ]
    },
    "cloud": {
      "color": "#E69F00",
      "description": "Cloudflare products, Workers, deployment and cloud infrastructure",
